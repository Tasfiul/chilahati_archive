<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        <%= typeof title !=='undefined' ? title : category %> - Chilahati Archive
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/list.css">
</head>

<body>

    <%- include('../partials/navbar') %>

        <div class="main-content">
            <header style="margin-bottom: 2rem;">
                <nav style="margin-bottom: 10px; font-size: 0.9rem; opacity: 0.7; text-transform: capitalize;">
                    <a href="/" style="color: white; text-transform: none;">Home</a> /
                    <a href="/archive/<%= category.replace(/\s+/g, '-') %>" style="color: white;">
                        <%= category %>
                    </a>
                    <% if (typeof subType !=='undefined' && subType) { %>
                        / <a href="/archive/<%= category.replace(/\s+/g, '-') %>/<%= subType %>" style="color: white;">
                            <%= subType %>
                        </a>
                        <% } %>
                </nav>

                <h1 style="text-transform: capitalize;">
                    <%= typeof title !=='undefined' ? title : category %>
                </h1>
                <p>
                    <%= items && items.length ? items.length : 0 %> entries found in this archive.
                </p>
            </header>

            <div class="menu-grid list-grid">
                <% if (items && items.length> 0) { %>
                    <% items.forEach(item=> { %>
                        <% const hasThumb=item.thumbnail && item.thumbnail.trim() !=='' ; %>
                            <a href="/entry/<%= item.slug %>" class="card item-card <%= !hasThumb ? 'no-thumb' : '' %>">
                                <% if(hasThumb) { %>
                                    <div class="item-thumb">
                                        <img src="<%= item.thumbnail %>" alt="<%= item.title %>"
                                            referrerpolicy="no-referrer">
                                    </div>
                                    <% } %>

                                        <div class="card-content">
                                            <h3>
                                                <%= item.title %>
                                            </h3>
                                            <p class="item-excerpt">Click to read the full archive...</p>
                                            <div class="item-meta" style="text-transform: capitalize;">
                                                <span class="badge">
                                                    <%= item.category %>
                                                </span>
                                                <% if (item.subType) { %>
                                                    <span class="muted"> • </span>
                                                    <span class="muted">
                                                        <%= item.subType %>
                                                    </span>
                                                    <% } %>
                                            </div>
                                        </div>
                                        <i class="fas fa-book-open card-arrow"></i>
                            </a>
                            <% }) %>
                                <% } else { %>
                                    <div class="empty-state" style="grid-column: 1/-1;">
                                        <i class="fas fa-inbox empty-icon"></i>
                                        <p class="empty-text">No entries found here yet. Be the first to contribute!</p>
                                    </div>
                                    <% } %>
            </div>

            <!-- PAGINATION -->
            <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                <div class="pagination">
                    <% if (currentPage> 1) { %>
                        <a href="?page=<%= currentPage - 1 %>" class="page-link">&laquo; Prev</a>
                        <% } %>

                            <% for(let i=1; i <=totalPages; i++) { %>
                                <a href="?page=<%= i %>" class="page-link <%= currentPage === i ? 'active' : '' %>">
                                    <%= i %>
                                </a>
                                <% } %>

                                    <% if (currentPage < totalPages) { %>
                                        <a href="?page=<%= currentPage + 1 %>" class="page-link">Next &raquo;</a>
                                        <% } %>
                </div>
                <% } %>

        </div>

        <%- include('../partials/footer') %>

</body>

</html>