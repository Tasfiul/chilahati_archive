<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Content Management - Chilahati Archive</title>
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin-add.css">
    <link rel="stylesheet" href="/css/content-management.css">
</head>

<body>

    <%- include('../partials/navbar') %>

        <div class="admin-container">
            <header class="admin-header">
                <h1><i class="fas fa-file-alt"></i> Content Management</h1>
                <p>Manage the entries you have contributed to the archive.</p>
                <div style="margin-top: 1.5rem; max-width: 500px;">
                    <form action="/admin/content-management" method="GET" style="display: flex; gap: 0.5rem;">
                        <input type="text" name="q" placeholder="Search your entries by title, category, etc..."
                            value="<%= searchQuery || '' %>"
                            style="flex: 1; padding: 0.8rem 1rem; border-radius: 8px; border: none; font-size: 0.95rem; outline: none; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                        <button type="submit"
                            style="padding: 0 1.5rem; border-radius: 8px; background: #fff; color: #2a5298; border: none; font-weight: 600; cursor: pointer; transition: all 0.2s;"><i
                                class="fas fa-search"></i> Search</button>
                    </form>
                </div>
            </header>

            <% if (locals.success_msg && success_msg.length> 0) { %>
                <div class="alert alert-success">
                    <%= success_msg %>
                </div>
                <% } %>
                    <% if (locals.error_msg && error_msg.length> 0) { %>
                        <div class="alert alert-danger">
                            <%= error_msg %>
                        </div>
                        <% } %>

                            <div class="management-list">
                                <% if (searchQuery) { %>
                                    <div
                                        style="margin-bottom: 1rem; padding: 0.8rem 1.2rem; background: rgba(74, 144, 226, 0.1); color: var(--text-color, inherit); border-radius: 8px; display: flex; justify-content: space-between; align-items: center; border: 1px solid rgba(74, 144, 226, 0.2);">
                                        <span><i class="fas fa-info-circle"
                                                style="color: #4a90e2; margin-right: 5px;"></i> Showing results for:
                                            <strong style="color: #000000;">"<%= searchQuery %>"</strong> (<%=
                                                totalItems %> found)</span>
                                        <a href="/admin/content-management"
                                            style="color: #0c0c0c; text-decoration: none; font-size: 0.9rem;"><i
                                                class="fas fa-times-circle"></i> Clear Search</a>
                                    </div>
                                    <% } %>
                                        <% if (items && items.length> 0) { %>
                                            <% items.forEach(item=> { %>
                                                <div class="management-item" id="item-<%= item._id %>">
                                                    <div class="item-info">
                                                        <h3>
                                                            <%= item.title %>
                                                        </h3>
                                                        <div class="item-meta">
                                                            <span class="item-category">
                                                                <%= item.category %>
                                                            </span>
                                                            <% if(item.subType) { %>
                                                                <span><i class="fas fa-tag"></i>
                                                                    <%= item.subType %>
                                                                </span>
                                                                <% } %>
                                                                    <span><i class="far fa-calendar-alt"></i>
                                                                        <%= new
                                                                            Date(item.createdAt).toLocaleDateString() %>
                                                                    </span>
                                                        </div>
                                                    </div>
                                                    <div class="item-actions">
                                                        <a href="/entry/<%= item.slug %>" target="_blank"
                                                            class="action-btn btn-view" title="View Entry">
                                                            <i class="fas fa-eye"></i> View
                                                        </a>
                                                        <a href="/admin/edit/<%= item._id %>"
                                                            class="action-btn btn-edit" title="Edit Entry">
                                                            <i class="fas fa-edit"></i> Edit
                                                        </a>
                                                        <button onclick="deleteItem('<%= item._id %>')"
                                                            class="action-btn btn-delete" title="Delete Entry">
                                                            <i class="fas fa-trash-alt"></i> Delete
                                                        </button>
                                                    </div>
                                                </div>
                                                <% }) %>
                                                    <% } else { %>
                                                        <div class="empty-state">
                                                            <i
                                                                class="<%= searchQuery ? 'fas fa-search-minus' : 'far fa-folder-open' %>"></i>
                                                            <h2>
                                                                <%= searchQuery ? 'No matches found'
                                                                    : 'No contents found' %>
                                                            </h2>
                                                            <p>
                                                                <%= searchQuery ? `We couldn't find any entries
                                                                    matching "${searchQuery}" .`
                                                                    : "You haven't added any entries to the archive yet."
                                                                    %>
                                                            </p>
                                                            <% if (searchQuery) { %>
                                                                <a href="/admin/content-management"
                                                                    class="action-btn btn-view"
                                                                    style="margin-top: 1rem;">
                                                                    <i class="fas fa-sync-alt"></i> View All Content
                                                                </a>
                                                                <% } else { %>
                                                                    <a href="/admin/add" class="action-btn btn-edit"
                                                                        style="margin-top: 1rem;">
                                                                        <i class="fas fa-plus"></i> Add New Entry
                                                                    </a>
                                                                    <% } %>
                                                        </div>
                                                        <% } %>
                            </div>

                            <!-- PAGINATION CONTROLS -->
                            <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                                <div class="pagination"
                                    style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 2rem;">
                                    <% let pageQuery=searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : '' ; %>

                                        <% if (currentPage> 1) { %>
                                            <a href="/admin/content-management?page=<%= currentPage - 1 %><%= pageQuery %>"
                                                class="action-btn btn-view">&laquo; Prev</a>
                                            <% } %>

                                                <% let startPage=Math.max(1, currentPage - 2); let
                                                    endPage=Math.min(totalPages, currentPage + 2); for(let i=startPage;
                                                    i <=endPage; i++) { %>
                                                    <a href="/admin/content-management?page=<%= i %><%= pageQuery %>"
                                                        class="action-btn <%= i === currentPage ? 'btn-edit' : 'btn-view' %>"
                                                        style="min-width: 40px; justify-content: center;">
                                                        <%= i %>
                                                    </a>
                                                    <% } %>

                                                        <% if (currentPage < totalPages) { %>
                                                            <a href="/admin/content-management?page=<%= currentPage + 1 %><%= pageQuery %>"
                                                                class="action-btn btn-view">Next &raquo;</a>
                                                            <% } %>
                                </div>
                                <% } %>
        </div>

        <!-- Delete Functionality -->
        <script>
            function deleteItem(itemId) {
                if (confirm('Are you sure you want to delete this content? This action cannot be undone.')) {
                    fetch('/admin/delete/' + itemId, {
                        method: 'DELETE'
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                // Remove the item from the DOM with a nice fade out
                                const itemElement = document.getElementById('item-' + itemId);
                                if (itemElement) {
                                    itemElement.style.opacity = '0';
                                    setTimeout(() => {
                                        itemElement.remove();
                                        // Check if list is empty now
                                        if (document.querySelectorAll('.management-item').length === 0) {
                                            location.reload(); // Reload to show empty state
                                        }
                                    }, 300);
                                } else {
                                    location.reload();
                                }
                            } else {
                                alert('Error deleting: ' + (data.error || 'Unknown error'));
                            }
                        })
                        .catch(e => {
                            console.error('Delete error:', e);
                            alert('Network error, please try again');
                        });
                }
            }
        </script>
</body>

</html>