<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Chilahati Archive</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin-dashboard.css">
</head>

<body>
    <%- include('../../partials/navbar') %>

        <div class="dashboard-container">
            <header style="margin-bottom: 2rem;">
                <h1>Admin Control Center</h1>
                <p style="opacity: 0.7;">System overview and user governance.</p>
            </header>

            <!-- Navbar Tab Row -->
            <div class="admin-nav">
                <div class="nav-tab active" onclick="switchTab('overview')">
                    <i class="fas fa-chart-line"></i> Overview
                </div>
                <div class="nav-tab" onclick="switchTab('users')">
                    <i class="fas fa-users-cog"></i> User Management
                </div>
            </div>

            <!-- OVERVIEW SECTION -->
            <div id="overview" class="tab-content active">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fas fa-users"></i></div>
                        <div class="stat-info">
                            <h3>Total Users</h3>
                            <div class="value">
                                <%= stats.totalUsers %>
                            </div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fas fa-layer-group"></i></div>
                        <div class="stat-info">
                            <h3>Total Entries</h3>
                            <div class="value">
                                <%= stats.totalEntries %>
                            </div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fas fa-eye"></i></div>
                        <div class="stat-info">
                            <h3>Traffic (Proxy)</h3>
                            <div class="value">Coming Soon</div>
                        </div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1.5fr; gap: 2rem;">
                    <div class="data-section">
                        <h3>Category Breakdown</h3>
                        <div class="category-grid" style="grid-template-columns: 1fr; margin-top: 1rem;">
                            <% stats.categories.forEach(cat=> { %>
                                <div class="cat-item">
                                    <span class="cat-name">
                                        <%= cat._id %>
                                    </span>
                                    <span class="cat-count">
                                        <%= cat.count %> items
                                    </span>
                                </div>
                                <% }) %>
                        </div>
                    </div>

                    <div class="data-section">
                        <h3>History of New Entries</h3>
                        <div class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Item Name</th>
                                        <th>Category</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% stats.recentEntries.forEach(item=> { %>
                                        <tr>
                                            <td><strong>
                                                    <%= item.title %>
                                                </strong></td>
                                            <td style="text-transform: capitalize;">
                                                <%= item.category %>
                                            </td>
                                            <td>
                                                <%= new Date(item.createdAt).toLocaleDateString() %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- USER MANAGEMENT SECTION -->
            <div id="users" class="tab-content">
                <div class="data-section">
                    <div class="section-header">
                        <h3>All Registered Users</h3>
                        <div class="controls">
                            <input type="text" id="userSearch" class="search-input"
                                placeholder="Search by name or email..." onkeyup="filterUsers()">
                            <select id="roleFilter" class="filter-select" onchange="filterUsers()">
                                <option value="all">All Roles</option>
                                <option value="admin">Admin</option>
                                <option value="supervisor">Supervisor</option>
                                <option value="user">User</option>
                            </select>
                        </div>
                    </div>

                    <div class="table-container">
                        <table id="userTable">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Joined</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach(u=> { %>
                                    <% const isSelf=u._id.toString()===user._id.toString(); %>
                                        <% const isAnotherAdmin=u.role==='admin' && !isSelf; %>
                                            <tr class="user-row" data-name="<%= u.username.toLowerCase() %>"
                                                data-email="<%= u.email.toLowerCase() %>" data-role="<%= u.role %>">
                                                <td>
                                                    <%= u.username %>
                                                        <%= isSelf ? '(You)' : '' %>
                                                </td>
                                                <td>
                                                    <%= u.email %>
                                                </td>
                                                <td>
                                                    <span class="role-badge role-<%= u.role %>">
                                                        <%= u.role %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <%= new Date(u.createdAt).toLocaleDateString() %>
                                                </td>
                                                <td>
                                                    <select class="btn-action"
                                                        onchange="updateRole('<%= u._id %>', this.value)"
                                                        <%=isAnotherAdmin ? 'disabled' : '' %>
                                                        title="<%= isAnotherAdmin
                                                            ? 'You cannot modify other administrators' : (isSelf
                                                            ? 'Demote yourself (Warning: You will lose access)'
                                                            : 'Change role' ) %>">
                                                            <option value="user" <%=u.role==='user' ? 'selected' : '' %>
                                                                >User
                                                            </option>
                                                            <option value="supervisor" <%=u.role==='supervisor'
                                                                ? 'selected' : '' %>
                                                                >Supervisor</option>
                                                            <option value="admin" <%=u.role==='admin' ? 'selected' : ''
                                                                %>>Admin
                                                            </option>
                                                    </select>
                                                    <button class="btn-action btn-delete"
                                                        onclick="deleteUser('<%= u._id %>')" <%=(isSelf ||
                                                        isAnotherAdmin) ? 'disabled' : '' %>
                                                        title="<%= isAnotherAdmin
                                                            ? 'You cannot delete other administrators' : (isSelf
                                                            ? 'You cannot delete yourself' : 'Delete user' ) %>">
                                                            <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <script>
            // Tab Switching
            function switchTab(tabId) {
                document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));

                document.getElementById(tabId).classList.add('active');
                event.currentTarget.classList.add('active');
            }

            // Filtering & Searching
            function filterUsers() {
                const searchVal = document.getElementById('userSearch').value.toLowerCase();
                const roleVal = document.getElementById('roleFilter').value;
                const rows = document.querySelectorAll('.user-row');

                rows.forEach(row => {
                    const name = row.dataset.name;
                    const email = row.dataset.email;
                    const role = row.dataset.role;

                    const matchesSearch = name.includes(searchVal) || email.includes(searchVal);
                    const matchesRole = (roleVal === 'all' || role === roleVal);

                    if (matchesSearch && matchesRole) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            // Backend Actions
            async function updateRole(userId, newRole) {
                if (!confirm(`Are you sure you want to change this user's role to ${newRole}?`)) return;

                try {
                    const res = await fetch('/admin/users/update-role', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ userId, newRole })
                    });
                    const data = await res.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                } catch (err) {
                    alert('Error updating role');
                }
            }

            async function deleteUser(userId) {
                if (!confirm('Are you sure you want to delete this user? This action cannot be undone.')) return;

                try {
                    const res = await fetch(`/admin/users/${userId}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                } catch (err) {
                    alert('Error deleting user');
                }
            }
        </script>
</body>

</html>